REDIS_ADDR=rediss://127.0.0.1:{{ valkey_cluster_cfg.ports.valkey }}
REDIS_USER=exporter
REDIS_PASSWORD={{ valkey_cluster_cfg.exporter_password }}
REDIS_EXPORTER_TLS_CA_CERT_FILE=/etc/redis_exporter/ca-bundle.crt
REDIS_EXPORTER_TLS_SERVER_CERT_FILE=/etc/redis_exporter/tls/tls.crt
REDIS_EXPORTER_TLS_SERVER_KEY_FILE=/etc/redis_exporter/tls/tls.key
REDIS_EXPORTER_TLS_SERVER_MIN_VERSION=TLS1.2
REDIS_EXPORTER_WEB_LISTEN_ADDRESS=:{{ valkey_cluster_cfg.ports.exporter }}
REDIS_EXPORTER_BASIC_AUTH_USERNAME={{ valkey_cluster_scrape_user }}
REDIS_EXPORTER_BASIC_AUTH_PASSWORD={{ valkey_cluster_scrape_password }}
REDIS_EXPORTER_CONFIG_COMMAND=-
REDIS_EXPORTER_DISABLE_SCRAPE_ENDPOINT=true
REDIS_EXPORTER_INCL_SYSTEM_METRICS=true
REDIS_EXPORTER_APPEND_INSTANCE_ROLE_LABEL=true
