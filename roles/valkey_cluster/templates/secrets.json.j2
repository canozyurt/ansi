{#- Every secret of the given instances (default: this one) as a JSON list. -#}
{%- set entries = valkey_cluster_secret_entries | default([valkey_cluster]) -%}
{%- set out = [] -%}
{%- for e in entries -%}
{%-   for k in ['admin_password', 'replication_password', 'sentinel_password', 'exporter_password', 'backup_password'] -%}
{%-     set _ = out.append((e[k] | default('')) | string) -%}
{%-   endfor -%}
{%-   for u in e.users | default([]) -%}
{%-     set _ = out.append((u.password | default('')) | string) -%}
{%-   endfor -%}
{%- endfor -%}
{{ out | to_json }}
