{#- One entry per (service, instance). Instances come from the definition's "instances" key
    (product playbooks); other services have one drill. -#}
{%- set plan = [] -%}
{%- for svc in dr_drill_selected -%}
{%-   set def = lookup('ansible.builtin.vars', 'dr_drill_' ~ svc) -%}
{%-   set instances = def.instances | default(none) -%}
{%-   if instances is none -%}
{%-     set _ = plan.append({'service': svc, 'instance': {}, 'label': svc}) -%}
{%-   else -%}
{%-     for inst in instances if (dr_drill_instance_filter | length == 0 or inst.name in dr_drill_instance_filter) -%}
{%-       set _ = plan.append({'service': svc, 'instance': inst, 'label': svc ~ '/' ~ inst.name}) -%}
{%-     endfor -%}
{%-   endif -%}
{%- endfor -%}
{{ plan | to_json }}
