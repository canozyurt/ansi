{#- Declared users with their password hashes and tags: application users get none; the Prometheus
    scrape user gets monitoring, which the authenticated metrics endpoint requires (read-only stats). -#}
{%- set out = [] -%}
{%- for v in rabbitmq_cluster_cfg.vhosts -%}
{%-   for u in v.users | default([]) -%}
{%-     set _ = out.append({'name': u.name, 'password_hash': u.password | rabbitmq_password_hash(rabbitmq_cluster_cfg.name ~ ':' ~ u.name), 'tags': []}) -%}
{%-   endfor -%}
{%- endfor -%}
{%- set _ = out.append({'name': rabbitmq_cluster_scrape_user,
                        'password_hash': rabbitmq_cluster_scrape_password | rabbitmq_password_hash(rabbitmq_cluster_cfg.name ~ ':' ~ rabbitmq_cluster_scrape_user),
                        'tags': ['monitoring']}) -%}
{{ out | to_json }}
