{#- Every secret of the given clusters (default: this one) as a JSON list. -#}
{%- set entries = rabbitmq_cluster_secret_entries | default([rabbitmq_cluster]) -%}
{%- set out = [] -%}
{%- for e in entries -%}
{%-   set _ = out.append((e.erlang_cookie | default('')) | string) -%}
{%-   set _ = out.append((e.admin_password | default('')) | string) -%}
{%-   for v in e.vhosts | default([]) -%}
{%-     for u in v.users | default([]) -%}
{%-       set _ = out.append((u.password | default('')) | string) -%}
{%-     endfor -%}
{%-   endfor -%}
{%- endfor -%}
{{ out | to_json }}
