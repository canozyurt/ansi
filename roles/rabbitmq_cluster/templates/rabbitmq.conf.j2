# {{ ansible_managed }}
# RabbitMQ cluster {{ rabbitmq_cluster_cfg.name }}, node {{ rabbitmq_cluster_nodename }}.
cluster_name = {{ rabbitmq_cluster_cfg.name }}

# ---- Clients: AMQP 0-9-1 over TLS only (SEC-03); no plaintext listener.
listeners.tcp = none
listeners.ssl.default = {{ rabbitmq_cluster_cfg.ports.amqps }}
ssl_options.cacertfile = /tls/ca-bundle.crt
ssl_options.certfile = /tls/tls.crt
ssl_options.keyfile = /tls/tls.key
ssl_options.verify = verify_none
ssl_options.fail_if_no_peer_cert = false
ssl_options.honor_cipher_order = true
ssl_options.versions.1 = tlsv1.3
ssl_options.versions.2 = tlsv1.2

# ---- Management UI and HTTP API over HTTPS only.
management.ssl.port = {{ rabbitmq_cluster_cfg.ports.management }}
management.ssl.cacertfile = /tls/ca-bundle.crt
management.ssl.certfile = /tls/tls.crt
management.ssl.keyfile = /tls/tls.key
management.ssl.honor_cipher_order = true
management.ssl.versions.1 = tlsv1.3
management.ssl.versions.2 = tlsv1.2
management.disable_stats = false

# ---- Prometheus metrics over HTTPS only, with basic auth (LOG-05).
prometheus.tcp.listener = none
prometheus.ssl.port = {{ rabbitmq_cluster_cfg.ports.prometheus }}
prometheus.ssl.cacertfile = /tls/ca-bundle.crt
prometheus.ssl.certfile = /tls/tls.crt
prometheus.ssl.keyfile = /tls/tls.key
prometheus.ssl.versions.1 = tlsv1.3
prometheus.ssl.versions.2 = tlsv1.2
prometheus.authentication.enabled = true

# ---- Cluster membership (HA-01): every member is listed; quorum queues are the default type.
cluster_formation.peer_discovery_backend = classic_config
{% for h in rabbitmq_cluster_hosts %}
cluster_formation.classic_config.nodes.{{ loop.index }} = rabbit@{{ hostvars[h].rabbitmq_cluster_my_address | default(h) }}
{% endfor %}
cluster_partition_handling = pause_minority
default_queue_type = quorum

# ---- Users: the break-glass administrator is created on first start; no guest user exists.
default_user = {{ rabbitmq_cluster_cfg.admin_user }}
default_pass = {{ rabbitmq_cluster_cfg.admin_password }}
default_user_tags.administrator = true
default_permissions.configure = .*
default_permissions.read = .*
default_permissions.write = .*
loopback_users = none

# ---- Resource alarms: publishers are blocked when memory or disk run low.
total_memory_available_override_value = {{ rabbitmq_cluster_cfg.resources.memory | upper | human_to_bytes }}
vm_memory_high_watermark.relative = {{ rabbitmq_cluster_cfg.vm_memory_high_watermark }}
disk_free_limit.absolute = {{ rabbitmq_cluster_cfg.disk_free_limit }}

# ---- Logs to stdout (journald through the container runtime, LOG-01).
log.console = true
log.console.level = info
log.file = false
log.connection.level = info

{% if rabbitmq_cluster_cfg.oauth.enabled | bool %}
# ---- Management UI login with Keycloak (IAM-01). Application users authenticate against the internal
# database; tokens are accepted by the OAuth 2.0 backend.
auth_backends.1 = internal
auth_backends.2 = oauth2
auth_oauth2.resource_server_id = {{ rabbitmq_cluster_oidc_client_id }}
auth_oauth2.issuer = {{ rabbitmq_cluster_oidc_issuer }}
auth_oauth2.preferred_username_claims.1 = preferred_username
auth_oauth2.preferred_username_claims.2 = sub
auth_oauth2.additional_scopes_key = roles
{% if rabbitmq_cluster_oidc_ca_file | length > 0 %}
auth_oauth2.https.cacertfile = /tls/oidc-ca.crt
{% endif %}
auth_oauth2.https.hostname_verification = wildcard
{% for role, scopes in rabbitmq_cluster_role_scopes.items() %}
{%   set expanded = [] %}
{%   for s in scopes %}
{%     if '{vhosts}' in s %}
{%       for v in rabbitmq_cluster_cfg.developer_vhosts %}
{%         set _ = expanded.append(s | replace('{vhosts}', v)) %}
{%       endfor %}
{%     else %}
{%       set _ = expanded.append(s) %}
{%     endif %}
{%   endfor %}
auth_oauth2.scope_aliases.{{ loop.index }}.alias = {{ role }}
auth_oauth2.scope_aliases.{{ loop.index }}.scope = {{ expanded | map('regex_replace', '^', rabbitmq_cluster_oidc_client_id ~ '.') | join(' ') }}
{% endfor %}
management.oauth_enabled = true
management.oauth_client_id = {{ rabbitmq_cluster_oidc_client_id }}
management.oauth_scopes = openid profile
management.oauth_disable_basic_auth = true
{% else %}
auth_backends.1 = internal
{% endif %}
