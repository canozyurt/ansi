# {{ ansible_managed }}
# With secrets_backend openbao the secrets are not here: the containers source /run/secrets/app.env (tmpfs).
DJANGO_DEBUG=False
{% set runtime = grc_secrets_runtime | default(false) | bool %}
{% if not runtime %}
DJANGO_SECRET_KEY={{ grc_secret_key }}
{% endif %}
CISO_ASSISTANT_URL={{ grc_hostname }}
ALLOWED_HOSTS={{ ([grc_hostname | urlsplit('hostname'), inventory_hostname, '127.0.0.1', 'localhost'] | unique) | join(',') }}
PORT={{ grc_backend_port }}
GUNICORN_WORKERS={{ grc_backend_workers }}
POSTGRES_NAME={{ grc_db_name }}
POSTGRES_USER={{ grc_db_user }}
{% if not runtime %}
POSTGRES_PASSWORD={{ grc_db_password }}
{% endif %}
DB_HOST={{ grc_db_host }}
DB_PORT={{ grc_db_port }}
POSTGRES_SSL_MODE={{ grc_db_sslmode }}
DJANGO_SUPERUSER_EMAIL={{ grc_admin_email }}
{% if not runtime %}
DJANGO_SUPERUSER_PASSWORD={{ grc_admin_password }}
{% endif %}
LOG_FORMAT=json
LOG_LEVEL={{ grc_log_level }}
EXPOSE_METRICS={{ grc_metrics_enabled | bool }}
AUDITLOG_RETENTION_DAYS={{ grc_auditlog_retention_days }}
{% if grc_email_host | length > 0 %}
EMAIL_HOST={{ grc_email_host }}
EMAIL_PORT={{ grc_email_port }}
EMAIL_HOST_USER={{ grc_email_user }}
{% if not runtime %}
EMAIL_HOST_PASSWORD={{ grc_email_password }}
{% endif %}
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL={{ grc_email_from }}
{% endif %}
