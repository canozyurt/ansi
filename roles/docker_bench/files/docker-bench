#!/usr/bin/env python3
"""Weekly CIS Docker Benchmark check (HRD-03), installed by roles/docker_bench.

Runs docker-bench-security from its pinned install directory, keeps the text and JSON logs under
the evidence directory, prints a summary (journald, identifier docker-bench) and writes textfile
metrics: results per outcome, WARN results that are not documented exceptions, the previous WARN
count and the score docker-bench reports.

Settings: /etc/docker-bench/config.json. For tests, `docker-bench --parse LOG.json` summarizes an
existing JSON log without running the benchmark.
"""

import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

CONFIG = "/etc/docker-bench/config.json"
OUTCOMES = ["PASS", "WARN", "INFO", "NOTE", "EXCEPTED"]


def log(message):
    print(message, flush=True)


def parse(path, exceptions):
    """Counts per outcome, non-excepted WARN ids and the reported score from a docker-bench JSON log."""
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    counts = {o: 0 for o in OUTCOMES}
    warnings = []
    for section in data.get("tests") or []:
        for result in section.get("results") or []:
            outcome = str(result.get("result", "")).upper()
            check = str(result.get("id", ""))
            if outcome == "WARN" and check in exceptions:
                outcome = "EXCEPTED"
            elif outcome == "WARN":
                warnings.append(f"{check} {result.get('desc', '')}".strip())
            counts[outcome] = counts.get(outcome, 0) + 1
    score = data.get("score")
    try:
        score = float(score)
    except (TypeError, ValueError):
        score = 0.0
    return counts, warnings, score


def write_metrics(cfg, counts, warnings, previous, score, ok, start):
    end = time.time()
    lines = [
        "# HELP docker_bench_results Results of the last docker-bench-security run by outcome.",
        "# TYPE docker_bench_results gauge",
    ]
    for outcome in OUTCOMES:
        lines.append(f'docker_bench_results{{result="{outcome.lower()}"}} {counts.get(outcome, 0)}')
    lines += [
        "# HELP docker_bench_warnings WARN results that are not documented exceptions.",
        "# TYPE docker_bench_warnings gauge",
        f"docker_bench_warnings {len(warnings)}",
        "# HELP docker_bench_previous_warnings WARN results (exceptions left out) of the run before the last one.",
        "# TYPE docker_bench_previous_warnings gauge",
        f"docker_bench_previous_warnings {previous}",
        "# HELP docker_bench_score Score reported by docker-bench-security.",
        "# TYPE docker_bench_score gauge",
        f"docker_bench_score {score}",
        "# HELP docker_bench_success 1 when the last run finished and its JSON log could be read.",
        "# TYPE docker_bench_success gauge",
        f"docker_bench_success {int(ok)}",
        "# HELP docker_bench_last_run_timestamp_seconds End of the last docker-bench-security run.",
        "# TYPE docker_bench_last_run_timestamp_seconds gauge",
        f"docker_bench_last_run_timestamp_seconds {int(end)}",
        "# HELP docker_bench_duration_seconds Duration of the last docker-bench-security run.",
        "# TYPE docker_bench_duration_seconds gauge",
        f"docker_bench_duration_seconds {int(end - start)}",
    ]
    out_dir = cfg["textfile_dir"]
    os.makedirs(out_dir, mode=0o755, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=out_dir, prefix=".docker_bench.prom.", delete=False) as fh:
        fh.write("\n".join(lines) + "\n")
    os.chmod(fh.name, 0o644)
    os.replace(fh.name, os.path.join(out_dir, "docker_bench.prom"))


def prune(evidence_dir, retention_days):
    cutoff = time.time() - retention_days * 86400
    for entry in os.scandir(evidence_dir):
        if entry.is_dir(follow_symlinks=False) and entry.stat().st_mtime < cutoff:
            shutil.rmtree(entry.path)
            log(f"removed evidence older than {retention_days} days: {entry.name}")


def run(cfg):
    start = time.time()
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H%M%SZ")
    try:
        with open(cfg["state_file"], encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}
    run_dir = os.path.join(cfg["evidence_dir"], stamp)
    os.makedirs(run_dir, mode=0o750, exist_ok=True)
    logfile = os.path.join(run_dir, "docker-bench.log")
    proc = subprocess.run(["./docker-bench-security.sh", "-b", "-l", logfile], cwd=cfg["install_dir"],
                          capture_output=True, text=True, check=False)
    with open(os.path.join(run_dir, "stdout.log"), "w", encoding="utf-8") as fh:
        fh.write(proc.stdout)
    json_log = logfile + ".json"
    previous = int(state.get("warnings", 0))
    if proc.returncode != 0 or not os.path.exists(json_log):
        log(f"docker-bench-security failed with exit code {proc.returncode}: {proc.stderr.strip()[-800:]}")
        write_metrics(cfg, {}, [], previous, 0.0, False, start)
        return 1
    try:
        counts, warnings, score = parse(json_log, set(cfg.get("exceptions", [])))
    except (OSError, ValueError) as exc:
        log(f"cannot read {json_log}: {exc}")
        write_metrics(cfg, {}, [], previous, 0.0, False, start)
        return 1
    if "warnings" not in state:
        previous = len(warnings)
    summary = {"host": os.uname().nodename, "time": stamp, "version": cfg.get("version"), "counts": counts,
               "warnings": warnings, "previous_warnings": previous, "score": score,
               "exceptions": cfg.get("exceptions", [])}
    with open(os.path.join(run_dir, "summary.json"), "w", encoding="utf-8") as fh:
        json.dump(summary, fh, indent=1, sort_keys=True)
    os.makedirs(os.path.dirname(cfg["state_file"]), mode=0o750, exist_ok=True)
    with open(cfg["state_file"], "w", encoding="utf-8") as fh:
        json.dump({"warnings": len(warnings), "time": stamp}, fh)
    write_metrics(cfg, counts, warnings, previous, score, True, start)
    prune(cfg["evidence_dir"], int(cfg["retention_days"]))
    log(f"pass={counts['PASS']} warn={len(warnings)} excepted={counts['EXCEPTED']} info={counts['INFO']} "
        f"note={counts['NOTE']} previous_warn={previous} score={score} evidence={run_dir}")
    for warning in warnings:
        log(f"WARN {warning}")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--parse", metavar="LOG_JSON", help="summarize an existing JSON log and exit")
    parser.add_argument("--exception", action="append", default=[], help="with --parse: excepted check id")
    args = parser.parse_args()
    if args.parse:
        counts, warnings, score = parse(args.parse, set(args.exception))
        print(json.dumps({"counts": counts, "warnings": warnings, "score": score}, indent=1, sort_keys=True))
        return 0
    os.umask(0o027)
    with open(CONFIG, encoding="utf-8") as fh:
        cfg = json.load(fh)
    return run(cfg)


if __name__ == "__main__":
    sys.exit(main())
