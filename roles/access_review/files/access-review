#!/usr/bin/env python3
"""Quarterly access review evidence (IAM-05), installed by roles/access_review.

  access-review run       write this host's review (local accounts; on the report host also the
                          Keycloak users, groups, roles, admins, last logins, disabled, stale and
                          service accounts, and the VPN peers from the inventory)
  access-review metrics   rewrite the textfile metrics from the saved state

Files go to <evidence_dir>/<YYYY-Qn>/<UTC time>/ as CSV plus one JSON with everything. The Keycloak
part uses the read-only service account (client credentials; secret in the environment from a 0600
file, never on a command line). For tests: `access-review keycloak-summary USERS.json` classifies a
saved user listing.
"""

import argparse
import csv
import datetime
import grp
import json
import os
import pwd
import shutil
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

CONFIG = "/etc/access-review/config.json"
DAY = 86400
NOLOGIN_SHELLS = {"/usr/sbin/nologin", "/sbin/nologin", "/bin/false", "/usr/bin/false", "/bin/sync", ""}
ADMIN_CLIENT_ROLES = {"realm-admin", "manage-users", "manage-realm", "manage-clients", "manage-authorization",
                      "manage-identity-providers", "impersonation", "manage-events"}


def log(message):
    print(message, flush=True)


def quarter(now):
    dt = datetime.datetime.fromtimestamp(now, datetime.timezone.utc)
    return f"{dt.year}-Q{(dt.month - 1) // 3 + 1}", dt.strftime("%Y-%m-%dT%H%M%SZ")


def iso(ts):
    if not ts:
        return ""
    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def write_csv(path, rows, fields):
    with open(path, "w", newline="", encoding="utf-8") as fh:
        writer = csv.DictWriter(fh, fieldnames=fields, extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow({k: ";".join(v) if isinstance(v, list) else v for k, v in row.items()})


# ---------------------------------------------------------------------------- local accounts
def read_shadow():
    entries = {}
    try:
        with open("/etc/shadow", encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split(":")
                if len(parts) >= 3:
                    entries[parts[0]] = parts
    except OSError:
        pass
    return entries


def sudo_rules(user):
    if not shutil.which("sudo"):
        return []
    proc = subprocess.run(["sudo", "-n", "-l", "-U", user], capture_output=True, text=True, check=False)
    if proc.returncode != 0 or "not allowed to run sudo" in proc.stdout:
        return []
    lines, capture = [], False
    for line in proc.stdout.splitlines():
        if line.strip().startswith("User ") and "may run the following commands" in line:
            capture = True
            continue
        if capture and line.strip():
            lines.append(line.strip())
    return lines


def last_login(user):
    for cmd in (["lastlog2", "-u", user], ["lastlog", "-u", user]):
        if shutil.which(cmd[0]):
            proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
            rows = proc.stdout.strip().splitlines()[1:]
            if rows:
                text = rows[0]
                return "" if "Never logged in" in text or "**Never" in text else " ".join(text.split()[-6:])
    return ""


def local_accounts(cfg):
    shadow = read_shadow()
    members = {}
    for group in grp.getgrall():
        for member in group.gr_mem:
            members.setdefault(member, []).append(group.gr_name)
    rows = []
    for entry in pwd.getpwall():
        name = entry.pw_name
        sh = shadow.get(name, [])
        password_hash = sh[1] if len(sh) > 1 else ""
        password_set = bool(password_hash) and not password_hash.startswith(("!", "*"))
        login_shell = entry.pw_shell not in NOLOGIN_SHELLS
        principals_file = os.path.join(cfg["principals_dir"], name)
        principals = []
        if os.path.exists(principals_file):
            with open(principals_file, encoding="utf-8") as fh:
                principals = [line.strip() for line in fh if line.strip() and not line.startswith("#")]
        keys_file = os.path.join(entry.pw_dir, ".ssh", "authorized_keys")
        keys = 0
        if os.path.exists(keys_file):
            with open(keys_file, encoding="utf-8", errors="replace") as fh:
                keys = sum(1 for line in fh if line.strip() and not line.startswith("#"))
        sudo = sudo_rules(name) if login_shell or principals or keys else []
        if entry.pw_uid < cfg["local_min_uid"] and entry.pw_uid != 0 and not (password_set or principals or keys or sudo):
            continue
        try:
            primary = {grp.getgrgid(entry.pw_gid).gr_name}
        except KeyError:
            primary = {str(entry.pw_gid)}
        groups = sorted(set(members.get(name, [])) | primary)
        last_change = int(sh[2]) * DAY if len(sh) > 2 and sh[2].isdigit() else 0
        rows.append({
            "account": name, "uid": entry.pw_uid, "shell": entry.pw_shell, "login_shell": login_shell,
            "password_set": password_set, "locked": password_hash.startswith("!"), "password_changed": iso(last_change),
            "groups": groups, "sudo": sudo, "privileged": bool(sudo) or entry.pw_uid == 0 or "sudo" in groups,
            "ssh_principals": principals, "authorized_keys": keys, "last_login": last_login(name),
        })
    return rows


# ---------------------------------------------------------------------------- Keycloak
class Keycloak:
    def __init__(self, kc, secret):
        self.base = kc["url"].rstrip("/")
        self.realm = kc["realm"]
        self.ctx = ssl.create_default_context()
        if not kc.get("validate_certs", True):
            self.ctx.check_hostname = False
            self.ctx.verify_mode = ssl.CERT_NONE
        data = urllib.parse.urlencode({"grant_type": "client_credentials", "client_id": kc["client_id"],
                                       "client_secret": secret}).encode()
        req = urllib.request.Request(f"{self.base}/realms/{self.realm}/protocol/openid-connect/token", data=data)
        with urllib.request.urlopen(req, context=self.ctx, timeout=30) as resp:
            self.token = json.load(resp)["access_token"]

    def get(self, path, **params):
        query = ("?" + urllib.parse.urlencode(params)) if params else ""
        req = urllib.request.Request(f"{self.base}/admin/realms/{self.realm}{path}{query}",
                                     headers={"Authorization": f"Bearer {self.token}"})
        with urllib.request.urlopen(req, context=self.ctx, timeout=60) as resp:
            return json.load(resp)

    def paged(self, path, page=100, **params):
        first = 0
        while True:
            batch = self.get(path, first=first, max=page, **params)
            yield from batch
            if len(batch) < page:
                return
            first += page

    def groups(self):
        def walk(groups):
            for group in groups:
                yield group
                children = group.get("subGroups") or []
                if not children and group.get("subGroupCount"):
                    children = list(self.paged(f"/groups/{group['id']}/children", briefRepresentation="false"))
                yield from walk(children)
        return list(walk(self.paged("/groups", briefRepresentation="false")))


def classify(users, now, stale_days, admin_roles):
    """Add disabled/stale/admin/service-account flags to collected user rows (pure; tested on samples)."""
    for user in users:
        created = (user.get("createdTimestamp") or 0) / 1000
        last = (user.get("last_login_ms") or 0) / 1000
        user["service_account"] = bool(user.get("serviceAccountClientId"))
        user["disabled"] = not user.get("enabled", True)
        user["admin"] = bool(set(user.get("realm_roles", [])) & set(admin_roles)) or bool(
            set(user.get("realm_management_roles", [])) & ADMIN_CLIENT_ROLES)
        reference = last or created
        user["stale"] = (not user["disabled"] and not user["service_account"]
                         and reference > 0 and now - reference > stale_days * DAY)
        user["never_logged_in"] = not last and not user["service_account"]
        user["created"] = iso(created)
        user["last_login"] = iso(last)
    return users


def keycloak_report(cfg, now):
    kc_cfg = cfg["keycloak"]
    kc = Keycloak(kc_cfg, os.environ.get("ACCESS_REVIEW_CLIENT_SECRET", ""))
    rm = kc.get("/clients", clientId="realm-management")
    rm_id = rm[0]["id"] if rm else None
    users = []
    for user in kc.paged("/users", briefRepresentation="false"):
        uid = user["id"]
        row = {k: user.get(k) for k in ("id", "username", "email", "firstName", "lastName", "enabled",
                                         "createdTimestamp", "serviceAccountClientId", "federationLink")}
        row["groups"] = sorted(g.get("path", g.get("name", "")) for g in kc.get(f"/users/{uid}/groups"))
        row["direct_roles"] = sorted(r["name"] for r in kc.get(f"/users/{uid}/role-mappings/realm"))
        row["realm_roles"] = sorted(r["name"] for r in kc.get(f"/users/{uid}/role-mappings/realm/composite"))
        row["realm_management_roles"] = sorted(
            r["name"] for r in kc.get(f"/users/{uid}/role-mappings/clients/{rm_id}/composite")) if rm_id else []
        events = kc.get("/events", type="LOGIN", user=uid, max=1)
        row["last_login_ms"] = events[0]["time"] if events else 0
        users.append(row)
    classify(users, now, kc_cfg["stale_days"], kc_cfg["admin_roles"])
    groups = []
    assignments = []
    for group in kc.groups():
        roles = sorted(r["name"] for r in kc.get(f"/groups/{group['id']}/role-mappings/realm"))
        members = [m["username"] for m in kc.paged(f"/groups/{group['id']}/members", briefRepresentation="true")]
        groups.append({"group": group.get("path", group["name"]), "realm_roles": roles, "members": len(members),
                       "member_list": sorted(members)})
        for role in roles:
            assignments.append({"subject_type": "group", "subject": group.get("path", group["name"]), "role": role, "via": "direct"})
            for member in members:
                assignments.append({"subject_type": "user", "subject": member, "role": role,
                                    "via": f"group {group.get('path', group['name'])}"})
    for user in users:
        for role in user["direct_roles"]:
            assignments.append({"subject_type": "user", "subject": user["username"], "role": role, "via": "direct"})
        for role in user["realm_management_roles"]:
            assignments.append({"subject_type": "user", "subject": user["username"], "role": f"realm-management/{role}",
                                "via": "client role"})
    return users, groups, assignments


def vpn_peers(peers, now):
    rows = []
    today = datetime.datetime.fromtimestamp(now, datetime.timezone.utc).date()
    for peer in peers:
        expires = str(peer.get("expires", ""))
        try:
            expired = datetime.date.fromisoformat(expires) < today
        except ValueError:
            expired = True  # no or unreadable expiry is reported as a finding
        rows.append({"name": peer.get("name", ""), "owner": peer.get("owner", ""), "allowed_ip": peer.get("allowed_ip", ""),
                     "expires": expires, "expired": expired})
    return rows


# ---------------------------------------------------------------------------- state and metrics
def load_state(cfg):
    try:
        with open(os.path.join(cfg["state_dir"], "state.json"), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(cfg, state):
    os.makedirs(cfg["state_dir"], mode=0o700, exist_ok=True)
    path = os.path.join(cfg["state_dir"], "state.json")
    with open(path + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.replace(path + ".tmp", path)


def write_metrics(cfg, state):
    lines = []

    def metric(name, help_text, samples):
        lines.extend([f"# HELP {name} {help_text}", f"# TYPE {name} gauge"] + samples)

    metric("access_review_deployed_timestamp_seconds", "When the access review job was set up on this host.",
           [f"access_review_deployed_timestamp_seconds {int(state.get('deployed', 0))}"])
    for part in ("local", "keycloak"):
        if part in state or part == "local" or cfg["keycloak"].get("enabled"):
            entry = state.get(part, {})
            metric(f"access_review_{part}_last_success_timestamp_seconds", f"End of the last successful {part} access review.",
                   [f"access_review_{part}_last_success_timestamp_seconds {int(entry.get('last_success', 0))}"])
            metric(f"access_review_{part}_last_status", f"1 if the last {part} access review succeeded.",
                   [f"access_review_{part}_last_status {int(entry.get('last_ok', 1 if not entry else 0))}"])
    counts = state.get("counts", {})
    if counts:
        metric("access_review_accounts", "Accounts in the last access review by source and kind.",
               [f'access_review_accounts{{source="{src}",kind="{kind}"}} {value}'
                for src, kinds in sorted(counts.items()) for kind, value in sorted(kinds.items())])
    os.makedirs(cfg["textfile_dir"], mode=0o755, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=cfg["textfile_dir"], prefix=".access_review.prom.", delete=False) as fh:
        fh.write("\n".join(lines) + "\n")
    os.chmod(fh.name, 0o644)
    os.replace(fh.name, os.path.join(cfg["textfile_dir"], "access_review.prom"))


def cmd_run(cfg):
    now = time.time()
    state = load_state(cfg)
    state.setdefault("deployed", int(now))
    counts = state.setdefault("counts", {})
    qtr, stamp = quarter(now)
    out = os.path.join(cfg["evidence_dir"], qtr, stamp)
    os.makedirs(out, mode=0o750, exist_ok=True)
    report = {"host": cfg["host"], "time": stamp, "quarter": qtr}
    failed = False

    try:
        accounts = local_accounts(cfg)
        write_csv(os.path.join(out, "local-accounts.csv"), accounts,
                  ["account", "uid", "shell", "login_shell", "password_set", "locked", "password_changed", "groups",
                   "sudo", "privileged", "ssh_principals", "authorized_keys", "last_login"])
        report["local_accounts"] = accounts
        counts["local"] = {"total": len(accounts), "privileged": sum(1 for a in accounts if a["privileged"]),
                           "password_set": sum(1 for a in accounts if a["password_set"])}
        state["local"] = {"last_success": int(time.time()), "last_ok": True}
        log(f"local accounts={len(accounts)} privileged={counts['local']['privileged']} evidence={out}")
    except Exception as exc:  # noqa: BLE001 -- the job reports any failure and keeps going
        state["local"] = dict(state.get("local", {}), last_ok=False)
        failed = True
        log(f"ERROR local account review failed: {exc}")

    if cfg["keycloak"].get("enabled"):
        try:
            users, groups, assignments = keycloak_report(cfg, now)
            fields = ["username", "email", "enabled", "disabled", "service_account", "serviceAccountClientId", "admin",
                      "stale", "never_logged_in", "created", "last_login", "groups", "realm_roles",
                      "realm_management_roles", "federationLink", "id"]
            write_csv(os.path.join(out, "keycloak-users.csv"), users, fields)
            write_csv(os.path.join(out, "keycloak-admins.csv"), [u for u in users if u["admin"]], fields)
            write_csv(os.path.join(out, "keycloak-disabled.csv"), [u for u in users if u["disabled"]], fields)
            write_csv(os.path.join(out, "keycloak-stale.csv"), [u for u in users if u["stale"]], fields)
            write_csv(os.path.join(out, "keycloak-service-accounts.csv"), [u for u in users if u["service_account"]], fields)
            write_csv(os.path.join(out, "keycloak-groups.csv"), groups, ["group", "realm_roles", "members", "member_list"])
            write_csv(os.path.join(out, "keycloak-role-assignments.csv"), assignments, ["subject_type", "subject", "role", "via"])
            peers = vpn_peers(cfg.get("vpn_peers", []), now)
            write_csv(os.path.join(out, "vpn-peers.csv"), peers, ["name", "owner", "allowed_ip", "expires", "expired"])
            report.update(keycloak={"realm": cfg["keycloak"]["realm"], "users": users, "groups": groups,
                                    "role_assignments": assignments}, vpn_peers=peers)
            counts["keycloak"] = {k: sum(1 for u in users if u[k]) for k in ("admin", "disabled", "stale", "service_account")}
            counts["keycloak"]["total"] = len(users)
            counts["vpn"] = {"total": len(peers), "expired": sum(1 for p in peers if p["expired"])}
            state["keycloak"] = {"last_success": int(time.time()), "last_ok": True}
            log(f"keycloak users={len(users)} admins={counts['keycloak']['admin']} disabled={counts['keycloak']['disabled']} "
                f"stale={counts['keycloak']['stale']} service_accounts={counts['keycloak']['service_account']} "
                f"vpn_peers={len(peers)} evidence={out}")
        except Exception as exc:  # noqa: BLE001
            state["keycloak"] = dict(state.get("keycloak", {}), last_ok=False)
            failed = True
            log(f"ERROR Keycloak access review failed: {exc}")

    with open(os.path.join(out, "access-review.json"), "w", encoding="utf-8") as fh:
        json.dump(report, fh, indent=1, sort_keys=True, default=str)
    save_state(cfg, state)
    write_metrics(cfg, state)
    return 1 if failed else 0


def cmd_metrics(cfg):
    state = load_state(cfg)
    if "deployed" not in state:
        state["deployed"] = int(time.time())
        save_state(cfg, state)
    write_metrics(cfg, state)
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=["run", "metrics", "keycloak-summary"])
    parser.add_argument("file", nargs="?", help="keycloak-summary: saved user rows (JSON list)")
    parser.add_argument("--now", type=float, default=None)
    parser.add_argument("--stale-days", type=int, default=90)
    args = parser.parse_args()
    if args.command == "keycloak-summary":
        with open(args.file, encoding="utf-8") as fh:
            users = json.load(fh)
        classify(users, args.now or time.time(), args.stale_days, ["platform-admin", "security-admin"])
        print(json.dumps([{k: u[k] for k in ("username", "admin", "disabled", "stale", "service_account", "last_login")}
                          for u in users], indent=1))
        return 0
    os.umask(0o027)
    with open(CONFIG, encoding="utf-8") as fh:
        cfg = json.load(fh)
    return cmd_run(cfg) if args.command == "run" else cmd_metrics(cfg)


if __name__ == "__main__":
    sys.exit(main())
