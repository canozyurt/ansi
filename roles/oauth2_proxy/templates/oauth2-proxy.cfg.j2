# {{ ansible_managed }}
# Options that are not in the alpha configuration. Secrets are files under /run/secrets.
reverse_proxy = true
redirect_url = "https://{{ oauth2_proxy_instance.hostname }}/oauth2/callback"
email_domains = ["*"]
skip_provider_button = true

# Access is decided by the "roles" claim (allowedGroups in alpha.yml), never by user name or email (IAM-03).
cookie_name = "_oauth2_proxy_{{ oauth2_proxy_instance.name | replace('-', '_') }}"
cookie_secret_file = "/run/secrets/cookie_secret"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
# IAM-04: at most the IdP's maximum session; refreshed with Keycloak every {{ oauth2_proxy_cookie_refresh }}, so
# a disabled user loses access within that time.
cookie_expire = "{{ oauth2_proxy_cookie_expire }}"
cookie_refresh = "{{ oauth2_proxy_cookie_refresh }}"
session_store_type = "cookie"

# Logs (LOG-01): authentication results and requests with the user, as JSON-friendly lines to journald.
request_logging = true
auth_logging = true
standard_logging = true
silence_ping_logging = true
real_client_ip_header = "X-Forwarded-For"
