# {{ ansible_managed }}
{% if trivy_scan_https_proxy | length > 0 %}
HTTPS_PROXY={{ trivy_scan_https_proxy }}
HTTP_PROXY={{ trivy_scan_https_proxy }}
NO_PROXY={{ trivy_scan_no_proxy }}
{% endif %}
{% if trivy_scan_db_repository | length > 0 %}
TRIVY_DB_REPOSITORY={{ trivy_scan_db_repository }}
{% endif %}
{% if trivy_scan_java_db_repository | length > 0 %}
TRIVY_JAVA_DB_REPOSITORY={{ trivy_scan_java_db_repository }}
{% endif %}
TRIVY_NO_PROGRESS=true
