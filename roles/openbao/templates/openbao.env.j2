# {{ ansible_managed }}
# The entrypoint must not chown bind mounts: the role sets ownership and the container runs unprivileged.
SKIP_CHOWN=true
BAO_ADDR=https://127.0.0.1:{{ openbao_api_port }}
BAO_CACERT=/openbao/tls/peers.pem
{% if openbao_seal_type == 'static' %}
BAO_STATIC_SEAL_KEY={{ openbao_static_seal_key }}
{% endif %}
{% for key, value in openbao_seal_env.items() %}
{{ key }}={{ value }}
{% endfor %}
