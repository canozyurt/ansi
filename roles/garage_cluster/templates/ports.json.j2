{#- Every port used by the Garage clusters on this host as a JSON list. -#}
{%- set out = [] -%}
{%- for e in garage_cluster_all if e.group | default('') in group_names -%}
{%-   set p = garage_cluster_defaults.ports | combine(e.ports | default({})) -%}
{%-   set _ = out.extend([p.s3, p.rpc, p.metrics, p.s3_local, p.admin_local]) -%}
{%- endfor -%}
{{ out | map('int') | list | to_json }}
