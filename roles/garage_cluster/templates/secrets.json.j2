{#- Every secret of the given clusters (default: this one) as a JSON list. -#}
{%- set entries = garage_cluster_secret_entries | default([garage_cluster]) -%}
{%- set out = [] -%}
{%- for e in entries -%}
{%-   for k in ['rpc_secret', 'admin_token', 'metrics_token'] -%}
{%-     set _ = out.append((e[k] | default('')) | string) -%}
{%-   endfor -%}
{%-   for k in e['keys'] | default([]) -%}
{%-     set _ = out.append((k.access_key_id | default('')) | string) -%}
{%-     set _ = out.append((k.secret_access_key | default('')) | string) -%}
{%-   endfor -%}
{%- endfor -%}
{{ out | to_json }}
