# {{ ansible_managed }}
# Evidence repository on {{ item }} (rest-server, append-only, shared by every host; EVD-02).
RESTIC_REPOSITORY=rest:https://{{ hostvars[item].backup_server_address | default(item) }}:{{ evidence_store_port }}/{{ evidence_store_user }}/
RESTIC_REST_USERNAME={{ evidence_store_user }}
RESTIC_REST_PASSWORD={{ evidence_store_rest_password }}
RESTIC_PASSWORD={{ evidence_store_repo_password }}
{% if evidence_store_cacert_file | length > 0 %}
RESTIC_CACERT={{ evidence_store_cacert_file }}
{% elif evidence_store_use_server_certs | bool %}
RESTIC_CACERT={{ evidence_store_server_ca_dir }}/{{ item }}.crt
{% endif %}
