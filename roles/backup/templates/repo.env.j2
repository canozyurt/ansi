# {{ ansible_managed }}
# restic repository on {{ item }} (rest-server, append-only, private to this host).
RESTIC_REPOSITORY=rest:https://{{ hostvars[item].backup_server_address | default(item) }}:{{ backup_rest_port }}/{{ backup_rest_user }}/
RESTIC_REST_USERNAME={{ backup_rest_user }}
RESTIC_REST_PASSWORD={{ backup_rest_password }}
RESTIC_PASSWORD={{ backup_repo_password }}
{% if backup_cacert_file | length > 0 %}
RESTIC_CACERT={{ backup_cacert_file }}
{% elif backup_fetch_server_certs | bool %}
RESTIC_CACERT={{ backup_config_dir }}/ca/{{ item }}.crt
{% endif %}
