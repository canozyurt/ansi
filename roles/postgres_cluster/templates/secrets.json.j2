{#- Every secret of the given clusters (default: this one), for the DAT-01 and strength checks. -#}
{%- set clusters = postgres_cluster_secret_clusters | default([postgres_cluster_cfg]) -%}
{%- set out = [] -%}
{%- for c in clusters -%}
{%-   for k in ['superuser_password', 'replication_password', 'rewind_password', 'patroni_api_password', 'exporter_password'] -%}
{%-     if (c[k] | default('') | string) | length > 0 %}{% set _ = out.append(c[k] | string) %}{% endif -%}
{%-   endfor -%}
{%-   if (c.backup | default({})).enabled | default(true) and ((c.backup | default({})).cipher_pass | default('') | string) | length > 0 -%}
{%-     set _ = out.append(c.backup.cipher_pass | string) -%}
{%-   endif -%}
{%-   if (c.openbao | default({})).enabled | default(false) and ((c.openbao | default({})).admin_password | default('') | string) | length > 0 -%}
{%-     set _ = out.append(c.openbao.admin_password | string) -%}
{%-   endif -%}
{%-   for db in c.databases | default([]) -%}
{%-     for u in db.users | default([]) -%}
{%-       if (u.password | default('') | string) | length > 0 %}{% set _ = out.append(u.password | string) %}{% endif -%}
{%-     endfor -%}
{%-   endfor -%}
{%- endfor -%}
{{ out | to_json }}
