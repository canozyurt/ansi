# {{ ansible_managed }}
# etcd member of PostgreSQL cluster {{ postgres_cluster_cfg.name }} (Patroni's DCS). Mutual TLS with the cluster's own CA.
ETCD_NAME={{ inventory_hostname }}
ETCD_DATA_DIR=/var/lib/etcd
ETCD_LISTEN_CLIENT_URLS=https://0.0.0.0:{{ postgres_cluster_cfg.ports.etcd_client }}
ETCD_ADVERTISE_CLIENT_URLS=https://{{ postgres_cluster_node_address }}:{{ postgres_cluster_cfg.ports.etcd_client }}
ETCD_LISTEN_PEER_URLS=https://0.0.0.0:{{ postgres_cluster_cfg.ports.etcd_peer }}
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://{{ postgres_cluster_node_address }}:{{ postgres_cluster_cfg.ports.etcd_peer }}
ETCD_INITIAL_CLUSTER={% for h in postgres_cluster_hosts %}{{ h }}=https://{{ hostvars[h].postgres_cluster_member_address }}:{{ postgres_cluster_cfg.ports.etcd_peer }}{{ ',' if not loop.last }}{% endfor %}

ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=postgres-{{ postgres_cluster_cfg.name }}
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_KEY_FILE=/etc/etcd/tls/node.key
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_PEER_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/node.key
ETCD_TLS_MIN_VERSION=TLS1.2
ETCD_AUTO_COMPACTION_MODE=periodic
ETCD_AUTO_COMPACTION_RETENTION=1h
ETCD_QUOTA_BACKEND_BYTES=2147483648
ETCD_LOGGER=zap
ETCD_LOG_OUTPUTS=stderr
ETCD_LOG_LEVEL=info
