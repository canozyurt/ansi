# {{ ansible_managed }}
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://{{ keycloak_db_host }}:{{ keycloak_db_port }}/{{ keycloak_db_name }}?sslmode={{ keycloak_db_sslmode }}
KC_DB_USERNAME={{ keycloak_db_user }}
{% if keycloak_secrets_runtime | default(false) | bool %}
# Passwords come from OpenBao, rendered by OpenBao Agent into tmpfs (IAM-08, SEC-02).
KC_CONFIG_FILE=/run/secrets/keycloak.conf
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
{% else %}
KC_DB_PASSWORD={{ keycloak_db_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password }}
{% endif %}
KC_HOSTNAME={{ keycloak_hostname }}
KC_HTTP_ENABLED=false
KC_HTTPS_PORT={{ keycloak_https_port }}
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/tls/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/tls/tls.key
KC_HTTPS_PROTOCOLS=TLSv1.3,TLSv1.2
{% if keycloak_proxy_headers %}
KC_PROXY_HEADERS={{ keycloak_proxy_headers }}
{% endif %}
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_MANAGEMENT_PORT={{ keycloak_management_port }}
KC_CACHE=ispn
KC_CACHE_STACK=jdbc-ping
KC_LOG=console
KC_LOG_CONSOLE_OUTPUT=json
KC_LOG_LEVEL={{ keycloak_log_level }}
KC_SPI_EVENTS_LISTENER_JBOSS_LOGGING_SUCCESS_LEVEL=info
KC_SPI_EVENTS_LISTENER_JBOSS_LOGGING_ERROR_LEVEL=warn
JAVA_OPTS_APPEND=-Djgroups.bind.address={{ ansible_facts['default_ipv4']['address'] | default('127.0.0.1') }} {{ keycloak_java_opts_append }}
