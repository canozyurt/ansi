# {{ ansible_managed }}
# Ships alerts{{ ' and archives' if wazuh_manager_archives_enabled | bool else '' }} to the indexer cluster.
# The password comes from the container environment (env file 0600), not from this file.
filebeat.modules:
  - module: wazuh
    alerts:
      enabled: true
    archives:
      enabled: {{ wazuh_manager_archives_enabled | bool | to_json }}

setup.template.json.enabled: true
setup.template.overwrite: true
setup.template.json.path: '/etc/filebeat/wazuh-template.json'
setup.template.json.name: 'wazuh'
setup.ilm.enabled: false
output.elasticsearch:
  hosts: {{ wazuh_manager_indexer_urls | to_json }}
  username: '${INDEXER_USERNAME}'
  password: '${INDEXER_PASSWORD}'
  ssl.verification_mode: full
  ssl.certificate_authorities: ['{{ wazuh_manager_cert_path }}/ca.pem']
  ssl.supported_protocols: [TLSv1.2, TLSv1.3]

logging.level: info
logging.to_stderr: true
logging.metrics.enabled: false

seccomp:
  default_action: allow
  syscalls:
    - action: allow
      names:
        - rseq
