#!/bin/sh
# Wazuh integration wrapper: runs the Python script with the manager's bundled interpreter.
# Called by wazuh-integratord as: custom-alertmanager <alert file> <api key> <hook url> [options file]
WAZUH_PATH="$(cd "$(dirname "$0")/.." && pwd -P)"
exec "${WAZUH_PATH}/framework/python/bin/python3" "${WAZUH_PATH}/integrations/custom-alertmanager.py" "$@"
