#!/bin/bash
# {{ ansible_managed }}
# Runs when OpenBao Agent re-rendered a secret of {{ openbao_secrets_service }} (new value or rotation).
set -euo pipefail
sleep 5   # let the agent finish writing every file of this render
container={{ openbao_secrets_on_change_container | quote }}
if [[ -n "$container" ]]; then
  running="$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' "$container" 2>/dev/null || true)"
  if [[ "$running" != "true" ]]; then
    logger -t openbao-secrets "secrets of {{ openbao_secrets_service }} changed; ${container} is not running, nothing to do"
    exit 0
  fi
fi
logger -t openbao-secrets "secrets of {{ openbao_secrets_service }} changed; applying them"
{% for command in openbao_secrets_on_change %}
{{ command }}
{% endfor %}
